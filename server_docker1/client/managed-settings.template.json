{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowedChannel": "enterprise",
  "permissions": {
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.3.117:8787/api/hooks/session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.3.117:8787/api/hooks/pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.3.117:8787/api/hooks/user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.3.117:8787/api/hooks/post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.3.117:8787/api/hooks/stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
